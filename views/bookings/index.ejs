<h2>My Bookings</h2>

<% for(let booking of bookings){ %>

    <div class="card mb-3">
        <div class="card-body">

            <h4>
                <%= booking.listing ? booking.listing.title : "Listing Removed" %>
            </h4>

            <p>
                Check In:
                <%= booking.checkIn.toDateString() %>
            </p>

            <p>
                Check Out:
                <%= booking.checkOut.toDateString() %>
            </p>

            <p>
                Total:
                ₹ <%= booking.totalPrice %>
            </p>


            <form method="POST" action="/bookings/<%= booking._id %>?_method=DELETE">

                <button class="btn btn-danger">
                    Cancel Booking
                </button>

            </form>


        </div>
    </div>

    <% } %>